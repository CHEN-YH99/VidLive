NODE_ENV=development

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_LOCAL_FILE_SIZE=104857600
MAX_CLOUD_FILE_SIZE=524288000
CLOUD_RETENTION_HOURS=24
CLOUD_QUEUE_CONCURRENCY=1
LOG_LEVEL=info
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
AUTH_COOKIE_SECURE=false
EMAIL_CODE_LOG_ENABLED=true
EMAIL_CODE_FROM="VidLive <no-reply@vidlive.local>"
# Optional: send verification emails through Resend. This takes precedence over SMTP and webhook.
# Resend requires EMAIL_CODE_FROM to use a sender you are allowed to send from.
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_TIMEOUT_MS=10000
# Optional: send verification emails directly through SMTP.
# Use EMAIL_CODE_SMTP_SECURE=true for port 465, false for port 587 STARTTLS.
EMAIL_CODE_SMTP_HOST=
EMAIL_CODE_SMTP_PORT=587
EMAIL_CODE_SMTP_SECURE=false
EMAIL_CODE_SMTP_USER=
EMAIL_CODE_SMTP_PASSWORD=
EMAIL_CODE_SMTP_TIMEOUT_MS=10000
# Optional: POST verification email payloads to your mail provider adapter.
EMAIL_CODE_WEBHOOK_URL=

# Cloud processing
DATABASE_URL=postgresql://vidlive:vidlive@localhost:5432/vidlive
REDIS_URL=redis://localhost:6379
R2_ENDPOINT=https://example.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET=vidlive-dev
R2_SIGNED_URL_TTL_SECONDS=3600
