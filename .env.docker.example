COMPOSE_PROJECT_NAME=vidlive

# Public ports exposed on the host.
WEB_PORT=8000
BACKEND_PORT=3010

# Runtime.
NODE_ENV=production
API_PORT=8000
PORT=8000
UPLOAD_DIR=/app/uploads
MAX_LOCAL_FILE_SIZE=104857600
MAX_CLOUD_FILE_SIZE=524288000

# PostgreSQL container.
POSTGRES_DB=video_prompt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_to_a_strong_password

# Backend service URLs inside the Docker network.
DATABASE_URL=postgresql://postgres:change_me_to_a_strong_password@postgres:5432/video_prompt?schema=public
REDIS_URL=redis://redis:6379

# Security.
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
AUTH_COOKIE_SECURE=true
CORS_ORIGIN=https://your-domain.example
EMAIL_CODE_LOG_ENABLED=false
EMAIL_CODE_FROM="VidLive <noreply@vidlive.cc.cd>"
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_TIMEOUT_MS=10000
EMAIL_CODE_SMTP_HOST=
EMAIL_CODE_SMTP_PORT=587
EMAIL_CODE_SMTP_SECURE=false
EMAIL_CODE_SMTP_USER=
EMAIL_CODE_SMTP_PASSWORD=
EMAIL_CODE_SMTP_TIMEOUT_MS=10000
EMAIL_CODE_WEBHOOK_URL=

# Optional object storage for generated ZIP artifacts.
# Leave empty to store artifacts in the backend_uploads Docker volume.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_SIGNED_URL_TTL_SECONDS=3600

# Frontend.
VITE_API_BASE_URL=/api
NEXT_PUBLIC_API_BASE_URL=/api
