# Dependencies and package manager caches
node_modules/
.pnpm-store/

# Build output and framework caches
dist/
**/dist/
.next/
**/.next/
.turbo/
coverage/
*.tsbuildinfo

# Local environment files
.env*
!.env.example
!.env.docker.example

# Local-only compose override (HTTP/LAN demo) —— 绝不能上线，会关掉 Secure Cookie
docker-compose.local.yml

# Logs and local process files
*.log
*.err.log
*.pid
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime-generated media and temporary files
uploads/
tmp/
backups/
server-backups/

# OS/editor noise
.DS_Store
Thumbs.db
.eslintcache

# Project docs: keep README files tracked, ignore other Markdown docs
*.md
!README*.md
!readme*.md
!**/README*.md
!**/readme*.md

# 线上维护手册包含敏感信息（服务器 IP、架构等），不应上传 GitHub
# 改为本地保存或使用私有文档管理工具
线上维护手册.md

# 安全审计报告包含敏感信息（服务器 IP、邮箱等），不应上传 GitHub
SECURITY_AUDIT.md
SECURITY_FIX_DEPLOYMENT.md
