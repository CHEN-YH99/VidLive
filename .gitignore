# Dependencies and package manager caches
node_modules/
.pnpm-store/

# Build output and framework caches
dist/
**/dist/
.next/
**/.next/
.turbo/
coverage/
*.tsbuildinfo

# Local environment files
.env*
!.env.example

# Logs and local process files
*.log
*.err.log
*.pid
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime-generated media and temporary files
uploads/
tmp/

# OS/editor noise
.DS_Store
Thumbs.db
.eslintcache

# Project docs: keep README files tracked, ignore other Markdown docs
*.md
!README*.md
!readme*.md
!**/README*.md
!**/readme*.md
